# Slice 0: valores locales de ejemplo, no credenciales de un servicio externo.
DATABASE_URL=postgresql://bolsasim:local-development-only@127.0.0.1:5432/bolsasim
TEST_DATABASE_URL=postgresql://bolsasim:local-test-only@127.0.0.1:5433/bolsasim_test
APP_TIME_ZONE=America/Bogota
LOG_LEVEL=info

# Reservadas para slices posteriores; Slice 0 no crea usuario ni depósito.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
SETTLEMENT_CURRENCY=COP
INITIAL_DEPOSIT_AMOUNT=10000000.00
# Legacy alias for existing local files; omit it for new profiles.
# INITIAL_DEPOSIT_COP=10000000.00

# mock: fixtures identificados; file: dataset real validado.
MARKET_DATA_ADAPTER=mock
MARKET_DATA_FILE_PATH=
MARKET_DATA_MANIFEST_PATH=
MARKET_DATA_RECENT_TTL_SECONDS=300
MARKET_DATA_HISTORICAL_TTL_SECONDS=86400
# demo:start actualiza el snapshot real una vez por día cuando es necesario.
# MARKET_DATA_AUTO_REFRESH=false

# Solo para adquirir/validar datos reales localmente; la aplicación no la
# expone ni la necesita cuando MARKET_DATA_ADAPTER=mock.
# TWELVE_DATA_API_KEY=

# Reservada para E2E: base dedicada que la suite trunca al iniciar; nunca la base de desarrollo.
# E2E_DATABASE_URL=postgresql://bolsasim:local-development-only@127.0.0.1:5432/bolsasim_e2e
